# Taiga MCP Server Configuration
# Copy this file to .env and fill in your values

# Transport mode (stdio or sse)
TAIGA_TRANSPORT=stdio

# Taiga API base URL
TAIGA_API_URL=http://localhost:9000

# Credentials for auto-authentication on server startup
# When set, the server will automatically authenticate and create a "default" session
# This eliminates the need to pass credentials through the AI conversation
TAIGA_USERNAME=your_username
TAIGA_PASSWORD=your_password

# Optional: only if Pangolin protects TAIGA_API_URL. See README "Taiga behind Pangolin".
# TAIGA_USERNAME / TAIGA_PASSWORD are still required.

# Option 1 (recommended): your own Pangolin login. Get the token from the dev-env
# `pangolin-login` script. Takes precedence over PANGOLIN_RESOURCE_TOKEN.
# PANGOLIN_DASHBOARD_URL=https://your-pangolin-host
# PANGOLIN_SESSION_TOKEN=your_session_token

# Option 2: a Share Link an admin created for the Taiga resource.
# Accepts the https://…/s/… URL, a ?p_token=ID.token URL, or bare ID.token.
# PANGOLIN_RESOURCE_TOKEN=https://your-pangolin-host/s/your-share-secret

# Rarely needed. Defaults match a stock Pangolin install.
# PANGOLIN_SESSION_COOKIE=p_session_token
# PANGOLIN_SESSION_REQUEST_PARAM=resource_session_request_param
# Legacy two-variable form of ID.token; ignored when PANGOLIN_RESOURCE_TOKEN is set.
# PANGOLIN_ACCESS_TOKEN_ID=your_token_id
# PANGOLIN_ACCESS_TOKEN=your_token_secret
